{
  "manifest_version": 3,
  "name": "claude-bridge",
  "version": "0.1.0",
  "description": "Exposes Claude Code cloud sessions as MCP tools",
  "key": "",
  "update_url": "https://pirateandfox.github.io/claude-bridge/updates.xml",
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
